{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:##}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "cmd", "/c", "npx", "-y",
        "@##",
        "##"
      ],
      "enabled": true
    }
  }
}
