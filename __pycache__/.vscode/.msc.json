{
  "inputs": [
    {
      "type": "promptString",
      "id": "github_token",
      "description": "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",
      "password": true
    },
    {
      "type": "promptString",
      "id": "db_password",
      "description": "Contraseña de la base de datos",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    },
    "dbhub": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub",
        "--transport",
        "stdio",
        "--dsn",
        "mysql://usuario:${input:db_password}@localhost:3306/nombre_db"
      ]
    }
  }
}
